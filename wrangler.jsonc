{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jasdor-v2",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    // Foto produk. Buat bucketnya dulu di dashboard Cloudflare (R2) dengan nama yang sama.
    { "binding": "FOTO", "bucket_name": "jasdor-v2-foto" }
  ],
  "observability": {
    "logs": { "enabled": true }
  },
  // Domain uji. Cloudflare membuat catatan DNS dan sertifikatnya sendiri saat deploy.
  "routes": [{ "pattern": "v2.cimagroup.my.id", "custom_domain": true }]
}
