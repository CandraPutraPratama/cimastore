# Salin menjadi .env.local untuk development. Jangan commit file .env.local.
# Variabel diisi bertahap sesuai tahap di docs/ARCHITECTURE.md.

# --- Supabase (Tahap 1) ---
# Project URL: tombol "Connect" di halaman project, atau Project Settings > Data API.
SUPABASE_URL=
# Secret key (sb_secret_...): Project Settings > API Keys > Secret keys.
# Hanya untuk server dan skrip import. Jangan pernah dipakai di kode browser.
SUPABASE_SECRET_KEY=

# Connection string database, hanya untuk skrip `npm run db:migrate` dan `npm run db:import`.
# Tombol "Connect" di halaman project > "Session pooler" > salin, lalu ganti [YOUR-PASSWORD]
# dengan password database project (bisa di-reset di Project Settings > Database).
DATABASE_URL=

# Tampilkan brand yang belum diaktifkan (pratinjau pemilik). Kosongkan / false di produksi.
CATALOG_PREVIEW=

# --- Pesanan (Tahap 3) ---
# Alamat publik website, dipakai untuk link "pantau pesanan" di pesan WhatsApp.
# Di laptop boleh kosong (otomatis http://localhost:3000).
SITE_URL=

# Bot Telegram untuk notifikasi pesanan admin. Buat bot BARU khusus v2 lewat @BotFather
# (satu bot hanya bisa punya satu webhook; bot v1 masih dipakai website lama).
TELEGRAM_BOT_TOKEN=
# Chat ID admin, pisahkan dengan koma. ID pertama = tujuan notifikasi (boleh ID grup).
# Cara tahu ID: kirim /start ke bot setelah webhook terpasang, bot membalas dengan Chat ID.
TELEGRAM_ADMIN_CHAT_ID=
# String acak bebas (misal 40 huruf/angka). Dipakai `npm run telegram:webhook` dan untuk
# memastikan update tombol benar-benar dari Telegram.
TELEGRAM_WEBHOOK_SECRET=

# Secret untuk penjadwal yang merapikan pesanan kedaluwarsa (POST /api/cron/expire-orders).
CRON_SECRET=
