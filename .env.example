# Salin menjadi .env.local untuk development. Jangan commit file .env.local.
# Variabel diisi bertahap sesuai tahap di docs/ARCHITECTURE.md.

# --- Supabase (Tahap 1) ---
# Project URL: tombol "Connect" di halaman project, atau Project Settings > Data API.
SUPABASE_URL=
# Secret key (sb_secret_...): Project Settings > API Keys > Secret keys.
# Hanya untuk server dan skrip import. Jangan pernah dipakai di kode browser.
SUPABASE_SECRET_KEY=

# Connection string database, hanya untuk skrip `npm run db:migrate` dan `npm run db:import`.
# Tombol "Connect" di halaman project > "Session pooler" > salin, lalu ganti [YOUR-PASSWORD]
# dengan password database project (bisa di-reset di Project Settings > Database).
DATABASE_URL=

# Tampilkan brand yang belum diaktifkan (pratinjau pemilik). Kosongkan / false di produksi.
CATALOG_PREVIEW=
