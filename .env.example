# Salin menjadi .env.local untuk development. Jangan commit file .env.local.
# Variabel diisi bertahap sesuai tahap di docs/ARCHITECTURE.md.

# --- Supabase (Tahap 1) ---
# Project URL: tombol "Connect" di halaman project, atau Project Settings > Data API.
SUPABASE_URL=
# Secret key (sb_secret_...): Project Settings > API Keys > Secret keys.
# Hanya untuk server dan skrip import. Jangan pernah dipakai di kode browser.
SUPABASE_SECRET_KEY=
